DATABASE_URL=sqlite:///./data/estatemonitor.db
CRAWL_DELAY_SEC=1.8
CRAWL_DELAY_JITTER_SEC=0.7
CRAWL_BLOCK_BACKOFF_SEC=12
CRAWL_MAX_PAGES=5
HTTP_TIMEOUT_SEC=30
HTTP_VERIFY_SSL=false
# Резидентный прокси для crawl с VPS (секрет). Пример:
# HTTP_PROXY=http://user:pass@host:port
# SOCKS5: HTTP_PROXY=socks5://user:pass@host:port  (нужен пакет socksio)
HTTP_PROXY=
ENRICH_DETAILS=true
MAX_DETAIL_PAGES=40
MIN_SEEN_FOR_VANISH=20
CRAWL_SCHEDULE_CRON=0 7 * * *
SCHEDULER_MAX_PAGES=8
SCHEDULER_MAX_DETAILS=80
BACKFILL_MAX_PAGES=15
BACKFILL_MAX_DETAILS=200
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36
LOG_LEVEL=INFO
